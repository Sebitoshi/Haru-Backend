generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── ENUMS ──────────────────────────────────────────

enum UserRole {
  user
  admin
  superadmin
}

enum QuestCategory {
  nature        // 🌿 Naturaleza
  creativity    // 🎨 Creatividad
  kindness      // ❤️ Bondad
  learning      // 🧠 Aprendizaje
  movement      // 🏃 Movimiento
  social        // 👥 Social
  photography   // 📸 Fotografía
  relaxation    // 🌙 Tranquilidad
  adventure     // 🗺️ Aventura
}

enum QuestDifficulty {
  easy
  normal
  hard
  special
}

enum UserQuestStatus {
  available
  accepted
  in_progress
  completed
  failed
  skipped
}

enum QuestType {
  daily
  weekly
  regular
  special
  ai_generated
  surprise
}

// ─── MODELS ─────────────────────────────────────────

model User {
  id                  String         @id @default(uuid())
  email               String         @unique
  username            String         @unique
  role                UserRole       @default(user)
  passwordHash        String?
  googleId            String?        @unique
  avatarUrl           String?
  avatarPublicId      String?
  bio                 String?
  onboardingCompleted Boolean        @default(false)
  emailVerified       Boolean        @default(false)
  emailVerifyToken    String?
  resetPasswordToken  String?
  resetPasswordExpires DateTime?
  level               Int            @default(1)
  totalXp             Int            @default(0)
  totalCoins          Int            @default(0)
  deletedAt           DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  lastLoginAt         DateTime?

  refreshTokens       RefreshToken[]
  preference          UserPreference?
  activityLogs        ActivityLog[]
  usernameHistory     UsernameHistory[]
  badges              UserBadge[]
  boti                BotiCharacter?
  userQuests          UserQuest[]
  streak              Streak?
  streakProtections   Int            @default(0) // items that protect 1 day of lost streak
  trust               UserTrust?
  verifications       QuestVerification[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  userAgent String?
  ip        String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  revoked   Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model UserPreference {
  id        String   @id @default(uuid())
  userId    String   @unique
  theme     String   @default("system")
  language  String   @default("es")
  sound     Boolean  @default(true)
  notifications Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  details   Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model UsernameHistory {
  id        String   @id @default(uuid())
  userId    String
  oldUsername String
  changedAt DateTime  @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([oldUsername])
}

model Badge {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String
  icon        String
  category    String
  requirement Json
  xpReward    Int      @default(0)
  coinsReward Int      @default(0)
  createdAt   DateTime @default(now())

  users UserBadge[]
}

model UserBadge {
  id        String   @id @default(uuid())
  userId    String
  badgeId   String
  unlockedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
  @@index([badgeId])
}

model BotiCharacter {
  id              String   @id @default(uuid())
  userId          String   @unique
  name            String   @default("BOTI")
  expression      String   @default("calm")
  mood            String   @default("neutral")
  bodyType        String   @default("standard")
  bodyColor       String   @default("#4FC3F7")
  eyeStyle        String   @default("round")
  mouthStyle      String   @default("smile")
  lastInteractedAt DateTime?
  totalInteractions Int     @default(0)
  personality     Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── QUEST MODELS ───────────────────────────────────

model Quest {
  id            String         @id @default(uuid())
  title         String
  description   String
  category      QuestCategory
  difficulty    QuestDifficulty @default(normal)
  duration      Int            // minutes
  xpReward      Int
  coinsReward   Int
  requirements  Json?          // { minLevel: 0, requiredItems: [], steps: [...] }
  type          QuestType      @default(regular)
  isAIGenerated Boolean        @default(false)
  isActive      Boolean        @default(true)
  minLevel      Int            @default(1) // level required to see this quest
  totalSteps    Int?           // for multi-step quests: null = single step
  weeklyReset   Boolean        @default(false) // resets every Monday
  maxCompletions Int?          // null = unlimited
  expiresAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  userQuests UserQuest[]
  verifications QuestVerification[]
}

model UserQuest {
  id          String         @id @default(uuid())
  userId      String
  questId     String
  status      UserQuestStatus @default(available)
  progress    Json?          // { currentStep: 1, totalSteps: 3, steps: [...] }
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime       @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest Quest @relation(fields: [questId], references: [id], onDelete: Cascade)
  verifications QuestVerification[]

  @@unique([userId, questId])
  @@index([userId])
  @@index([questId])
  @@index([status])
}

// ─── STREAK MODEL ──────────────────────────────────

model Streak {
  id              String   @id @default(uuid())
  userId          String   @unique
  currentStreak   Int      @default(0)
  longestStreak   Int      @default(0)
  lastActivityDate DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── TRUST MODEL ──────────────────────────────────

enum TrustLevel {
  new_user        // 👤 Recién registrado
  trustworthy     // 🌱 Confiable (5+ misiones, sin incidentes)
  very_trustworthy // 🌿 Muy confiable (20+ misiones, 30+ días)
  excellent       // ⭐ Excelente reputación (50+ misiones, 90+ días)
}

model UserTrust {
  id                String      @id @default(uuid())
  userId            String      @unique
  level             TrustLevel  @default(new_user)
  score             Int         @default(50) // 0-100, starts at 50 (neutral)
  totalAccepted     Int         @default(0)
  totalRejected     Int         @default(0)
  totalReports      Int         @default(0)
  fraudAttempts     Int         @default(0)
  cooldownUntil     DateTime?   // After fraud: no positive trust gains for 7 days
  lastFraudAt       DateTime?   // When the last fraud was detected
  rehabilitatedAt   DateTime?   // When rehabilitation was completed
  scoreBeforeFraud  Int?        // Score before fraud (for rehabilitation)
  lastEvaluatedAt   DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  events TrustEvent[]

  @@index([userId])
  @@index([level])
  @@index([score])
}

model TrustEvent {
  id        String   @id @default(uuid())
  userId    String
  type      String   // verification_accepted, verification_rejected, report, fraud_detected, etc.
  impact    Int      // +/- score impact
  details   Json?    // { verificationId, questId, reason, ... }
  createdAt DateTime @default(now())

  trust UserTrust @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

// ─── VERIFICATION MODEL ────────────────────────────

enum VerificationStatus {
  pending
  analyzing
  verified
  rejected
  needs_review
}

enum EvidenceType {
  photo
  video
  audio
  text
  location
}

model QuestVerification {
  id            String             @id @default(uuid())
  userId        String
  questId       String
  userQuestId   String
  evidenceType  EvidenceType
  evidenceUrl   String?            // Cloudinary URL for photo/video/audio
  evidenceText  String?            // Text description
  location      Json?              // { lat, lng, name? }
  status        VerificationStatus @default(pending)
  aiAnalysis    Json?              // { confidence, tags, notes, isAuthentic }
  rejectionReason String?
  attemptNumber Int                @default(1) // which attempt (max 3)
  reviewerId    String?            // for manual review
  reviewNote    String?
  submittedAt   DateTime           @default(now())
  reviewedAt    DateTime?
  createdAt     DateTime           @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest Quest @relation(fields: [questId], references: [id], onDelete: Cascade)
  userQuest UserQuest @relation(fields: [userQuestId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([questId])
  @@index([userQuestId])
  @@index([status])
}
