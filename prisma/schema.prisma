generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── ENUMS ──────────────────────────────────────────

enum UserRole {
  user
  admin
  superadmin
}

enum QuestCategory {
  nature        // 🌿 Naturaleza
  creativity    // 🎨 Creatividad
  kindness      // ❤️ Bondad
  learning      // 🧠 Aprendizaje
  movement      // 🏃 Movimiento
  social        // 👥 Social
  photography   // 📸 Fotografía
  relaxation    // 🌙 Tranquilidad
  adventure     // 🗺️ Aventura
}

enum QuestDifficulty {
  easy
  normal
  hard
  special
}

enum UserQuestStatus {
  available
  accepted
  in_progress
  completed
  failed
  skipped
}

enum QuestType {
  daily
  weekly
  regular
  special
  ai_generated
  surprise
}

// ─── MODELS ─────────────────────────────────────────

model User {
  id                  String         @id @default(uuid())
  email               String         @unique
  username            String         @unique
  role                UserRole       @default(user)
  passwordHash        String?
  googleId            String?        @unique
  avatarUrl           String?
  avatarPublicId      String?
  bio                 String?
  onboardingCompleted Boolean        @default(false)
  emailVerified       Boolean        @default(false)
  emailVerifyToken    String?
  resetPasswordToken  String?
  resetPasswordExpires DateTime?
  level               Int            @default(1)
  totalXp             Int            @default(0)
  totalCoins          Int            @default(0)
  deletedAt           DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  lastLoginAt         DateTime?

  refreshTokens       RefreshToken[]
  preference          UserPreference?
  activityLogs        ActivityLog[]
  usernameHistory     UsernameHistory[]
  badges              UserBadge[]
  boti                BotiCharacter?
  userQuests          UserQuest[]
  streak              Streak?
  streakProtections   Int            @default(0) // items that protect 1 day of lost streak
  trust               UserTrust?
  verifications       QuestVerification[]
  diaryEntries        DiaryEntry[]
  friendshipsAsRequester Friendship[]  @relation("FriendshipRequester")
  friendshipsAsAddressee Friendship[]  @relation("FriendshipAddressee")
  following            UserFollow[]   @relation("Following")
  followedBy          UserFollow[]   @relation("FollowedBy")
  activityFeed        FriendActivity[]
  celebrations        Celebration[]
  sentQuestChallenges QuestChallenge[] @relation("QuestChallengeSender")
  receivedQuestChallenges QuestChallenge[] @relation("QuestChallengeReceiver")
  collectibles     UserCollectible[]
  transactions     Transaction[]
  shopPurchases    UserShopPurchase[]
  equippedItems    UserEquipped[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  userAgent String?
  ip        String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  revoked   Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model UserPreference {
  id        String   @id @default(uuid())
  userId    String   @unique
  theme     String   @default("system")
  language  String   @default("es")
  sound     Boolean  @default(true)
  notifications Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  details   Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model UsernameHistory {
  id        String   @id @default(uuid())
  userId    String
  oldUsername String
  changedAt DateTime  @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([oldUsername])
}

model Badge {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String
  icon        String
  category    String
  requirement Json
  xpReward    Int      @default(0)
  coinsReward Int      @default(0)
  createdAt   DateTime @default(now())

  users UserBadge[]
}

model UserBadge {
  id        String   @id @default(uuid())
  userId    String
  badgeId   String
  unlockedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
  @@index([badgeId])
}

model BotiCharacter {
  id              String   @id @default(uuid())
  userId          String   @unique
  name            String   @default("BOTI")
  expression      String   @default("calm")
  mood            String   @default("neutral")
  bodyType        String   @default("standard")
  bodyColor       String   @default("#4FC3F7")
  eyeStyle        String   @default("round")
  mouthStyle      String   @default("smile")
  lastInteractedAt DateTime?
  totalInteractions Int     @default(0)
  personality     Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── QUEST MODELS ───────────────────────────────────

model Quest {
  id            String         @id @default(uuid())
  title         String
  description   String
  category      QuestCategory
  difficulty    QuestDifficulty @default(normal)
  duration      Int            // minutes
  xpReward      Int
  coinsReward   Int
  requirements  Json?          // { minLevel: 0, requiredItems: [], steps: [...] }
  type          QuestType      @default(regular)
  isAIGenerated Boolean        @default(false)
  isActive      Boolean        @default(true)
  minLevel      Int            @default(1) // level required to see this quest
  totalSteps    Int?           // for multi-step quests: null = single step
  weeklyReset   Boolean        @default(false) // resets every Monday
  maxCompletions Int?          // null = unlimited
  expiresAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  userQuests UserQuest[]
  verifications QuestVerification[]
  challenges QuestChallenge[]
}

model UserQuest {
  id          String         @id @default(uuid())
  userId      String
  questId     String
  status      UserQuestStatus @default(available)
  progress    Json?          // { currentStep: 1, totalSteps: 3, steps: [...] }
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime       @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest Quest @relation(fields: [questId], references: [id], onDelete: Cascade)
  verifications QuestVerification[]

  @@unique([userId, questId])
  @@index([userId])
  @@index([questId])
  @@index([status])
}

// ─── STREAK MODEL ──────────────────────────────────

model Streak {
  id              String   @id @default(uuid())
  userId          String   @unique
  currentStreak   Int      @default(0)
  longestStreak   Int      @default(0)
  lastActivityDate DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── TRUST MODEL ──────────────────────────────────

enum TrustLevel {
  new_user        // 👤 Recién registrado
  trustworthy     // 🌱 Confiable (5+ misiones, sin incidentes)
  very_trustworthy // 🌿 Muy confiable (20+ misiones, 30+ días)
  excellent       // ⭐ Excelente reputación (50+ misiones, 90+ días)
}

model UserTrust {
  id                String      @id @default(uuid())
  userId            String      @unique
  level             TrustLevel  @default(new_user)
  score             Int         @default(50) // 0-100, starts at 50 (neutral)
  totalAccepted     Int         @default(0)
  totalRejected     Int         @default(0)
  totalReports      Int         @default(0)
  fraudAttempts     Int         @default(0)
  cooldownUntil     DateTime?   // After fraud: no positive trust gains for 7 days
  lastFraudAt       DateTime?   // When the last fraud was detected
  rehabilitatedAt   DateTime?   // When rehabilitation was completed
  scoreBeforeFraud  Int?        // Score before fraud (for rehabilitation)
  lastEvaluatedAt   DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  events TrustEvent[]

  @@index([userId])
  @@index([level])
  @@index([score])
}

model TrustEvent {
  id        String   @id @default(uuid())
  userId    String
  type      String   // verification_accepted, verification_rejected, report, fraud_detected, etc.
  impact    Int      // +/- score impact
  details   Json?    // { verificationId, questId, reason, ... }
  createdAt DateTime @default(now())

  trust UserTrust @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

// ─── DIARY MODEL ──────────────────────────────────

enum DiaryMood {
  amazing   // 🤩
  happy     // 😊
  calm      // 😌
  tired     // 😴
  reflective // 🤔
}

model DiaryEntry {
  id            String    @id @default(uuid())
  userId        String
  questId       String?
  userQuestId   String?
  title         String
  description   String?
  photoUrl      String?   // Cloudinary URL from verification
  location      Json?     // { lat, lng, name? }
  mood          DiaryMood?
  category      String?   // QuestCategory as string for flexibility
  xpEarned      Int       @default(0)
  coinsEarned   Int       @default(0)
  tags          String[]  // custom tags
  isFavorite    Boolean   @default(false)
  isHidden      Boolean   @default(false) // soft delete
  sharedAt      DateTime? // when shared publicly
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([category])
  @@index([createdAt])
  @@index([isFavorite])
  @@index([mood])
}

// ─── SOCIAL MODELS ────────────────────────────────

enum FriendshipStatus {
  pending
  accepted
  blocked
}

model Friendship {
  id          String           @id @default(uuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(pending)
  createdAt   DateTime         @default(now())
  acceptedAt  DateTime?

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([requesterId])
  @@index([addresseeId])
  @@index([status])
}

model UserFollow {
  id         String   @id @default(uuid())
  followerId String
  followeeId String
  createdAt  DateTime @default(now())

  follower User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  followee User @relation("FollowedBy", fields: [followeeId], references: [id], onDelete: Cascade)

  @@unique([followerId, followeeId])
  @@index([followerId])
  @@index([followeeId])
}

enum ActivityVisibility {
  public
  friends
  private
}

enum FriendActivityType {
  quest_completed
  level_up
  streak_milestone
  badge_unlocked
  quest_shared
  diary_shared
  diary_favorited
}

model FriendActivity {
  id          String              @id @default(uuid())
  userId      String
  type        FriendActivityType
  details     Json?               // { questTitle, category, level, streakDays, badgeName, ... }
  visibility  ActivityVisibility  @default(friends)
  createdAt   DateTime            @default(now())

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  celebrations Celebration[]

  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@index([visibility])
}

model Celebration {
  id          String   @id @default(uuid())
  activityId  String
  userId      String   // who celebrated
  type        String   // "clap" | "fire" | "heart" | "star"
  createdAt   DateTime @default(now())

  activity FriendActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([activityId, userId, type])
  @@index([activityId])
  @@index([userId])
}

model QuestChallenge {
  id          String   @id @default(uuid())
  senderId    String
  receiverId  String
  questId     String
  message     String?
  status      String   @default("pending") // pending | accepted | completed | declined
  createdAt   DateTime @default(now())
  expiresAt   DateTime?

  sender   User @relation("QuestChallengeSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("QuestChallengeReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  quest    Quest @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
  @@index([status])
}

// ─── COLLECTION MODEL ─────────────────────────────

enum CollectibleType {
  badge     // 🏅 Insignias
  plant     // 🌱 Plantas
  object    // 🎒 Objetos
  postcard  // 📮 Postales
  special   // ⭐ Especiales
}

enum CollectibleRarity {
  common      // Fácil de obtener
  uncommon    // Requiere esfuerzo
  rare        // Difícil
  epic        // Muy difícil
  legendary   // Extremadamente raro
}

enum CollectibleSource {
  quest        // Al completar misión
  achievement  // Al desbloquear logro
  streak       // Por racha
  level        // Por nivel
  event        // Evento especial
  purchase     // Comprado en tienda
}

model Collectible {
  id          String              @id @default(uuid())
  code        String              @unique
  name        String
  description String
  type        CollectibleType
  rarity      CollectibleRarity   @default(common)
  imageUrl    String?             // illustration/icon URL
  requirement Json                // { type: 'quests_completed', category?: 'nature', value: 5 }
  xpReward    Int                 @default(0)
  coinsReward Int                 @default(0)
  isActive    Boolean             @default(true)
  isLimited   Boolean             @default(false) // event-only
  expiresAt   DateTime?           // for limited items
  createdAt   DateTime            @default(now())

  users UserCollectible[]

  @@index([type])
  @@index([rarity])
  @@index([code])
}

model UserCollectible {
  id            String   @id @default(uuid())
  userId        String
  collectibleId String
  source        CollectibleSource @default(quest)
  seen          Boolean  @default(false) // user has viewed it
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  collectible Collectible @relation(fields: [collectibleId], references: [id], onDelete: Cascade)

  @@unique([userId, collectibleId])
  @@index([userId])
  @@index([collectibleId])
  @@index([unlockedAt])
}

// ─── ADMIN MODELS ─────────────────────────────────

enum ReportStatus {
  pending
  reviewed
  resolved
  dismissed
}

enum ReportReason {
  inappropriate_content
  fraud
  spam
  harassment
  fake_evidence
  other
}

model Report {
  id          String       @id @default(uuid())
  reporterId  String       // who reported
  targetUserId String?     // user being reported
  targetEntryId String?    // diary entry being reported
  targetVerificationId String? // verification being reported
  reason      ReportReason
  description String?
  status      ReportStatus @default(pending)
  reviewedBy  String?      // admin who reviewed
  reviewNote  String?
  resolvedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status])
  @@index([reporterId])
  @@index([targetUserId])
  @@index([createdAt])
}

model SystemConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  category  String   @default("general") // general, rewards, rate_limits, features
  description String?
  updatedBy String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([key])
  @@index([category])
}

// ─── VERIFICATION MODEL ────────────────────────────

enum VerificationStatus {
  pending
  analyzing
  verified
  rejected
  needs_review
}

enum EvidenceType {
  photo
  video
  audio
  text
  location
}

model QuestVerification {
  id            String             @id @default(uuid())
  userId        String
  questId       String
  userQuestId   String
  evidenceType  EvidenceType
  evidenceUrl   String?            // Cloudinary URL for photo/video/audio
  evidenceText  String?            // Text description
  location      Json?              // { lat, lng, name? }
  status        VerificationStatus @default(pending)
  aiAnalysis    Json?              // { confidence, tags, notes, isAuthentic }
  rejectionReason String?
  attemptNumber Int                @default(1) // which attempt (max 3)
  reviewerId    String?            // for manual review
  reviewNote    String?
  submittedAt   DateTime           @default(now())
  reviewedAt    DateTime?
  createdAt     DateTime           @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest Quest @relation(fields: [questId], references: [id], onDelete: Cascade)
  userQuest UserQuest @relation(fields: [userQuestId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([questId])
  @@index([userQuestId])
  @@index([status])
}

// ─── ECONOMY MODELS ───────────────────────────────

enum TransactionType {
  quest_completed
  badge_unlocked
  collectible_unlocked
  level_up
  streak_milestone
  daily_bonus
  admin_grant
  refund
  shop_purchase
  streak_protection
  gifting
  admin_deduction
  welcome_bonus
}

model Transaction {
  id          String          @id @default(uuid())
  userId      String
  type        TransactionType
  amount      Int             // positive = earn, negative = spend
  balance     Int             // balance after this transaction
  source      String          // quest_id, badge_code, item_code, etc.
  description String?         // human-readable description
  metadata    Json?           // extra details: { questTitle, itemName, ... }
  createdAt   DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@index([userId, createdAt])
}

enum ShopItemCategory {
  protection   // 🛡️ Protección de racha
  cosmetic     // 👕 Cosméticos
  decoration   // 🏠 Decoraciones
  special      // ⭐ Items especiales
}

enum ShopItemRarity {
  common
  uncommon
  rare
  epic
  legendary
}

model ShopItem {
  id          String           @id @default(uuid())
  code        String           @unique
  name        String
  description String
  category    ShopItemCategory
  rarity      ShopItemRarity   @default(common)
  price       Int              // coins cost
  imageUrl    String?          // item illustration
  effect      Json             // { type: 'streak_protection', value: 1 } or { type: 'cosmetic', key: 'theme', value: 'dark' }
  isActive    Boolean          @default(true)
  isLimited   Boolean          @default(false)
  expiresAt   DateTime?
  maxPerUser  Int?             // null = unlimited
  createdAt   DateTime         @default(now())

  purchases UserShopPurchase[]

  @@index([category])
  @@index([rarity])
  @@index([code])
}

model UserShopPurchase {
  id        String   @id @default(uuid())
  userId    String
  itemId    String
  quantity  Int      @default(1)
  totalCost Int      // price * quantity
  equipped  Boolean  @default(false) //是否已装备
  createdAt DateTime @default(now())

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  item ShopItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([itemId])
  @@index([createdAt])
}

// ─── CUSTOMIZATION MODELS ─────────────────────────

enum EquipSlot {
  body          // Cuerpo de Boti
  color         // Color del cuerpo
  clothing      // Ropa
  head          // Sombreros / accesorios de cabeza
  eyes          // Estilo de ojos
  accessories   // Accesorios (lentes, Collares, etc.)
  expression    // Expresión facial
  effect        // Efectos visuales
  theme         // Tema del perfil
  title         // Título del perfil
  frame         // Marco del avatar
}

model UserEquipped {
  id        String    @id @default(uuid())
  userId    String
  slot      EquipSlot
  itemId    String    // ShopItem.code
  itemName  String    // cached name for display
  itemImage String?   // cached imageUrl
  equippedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, slot])
  @@index([userId])
  @@index([slot])
}
